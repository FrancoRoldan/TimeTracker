# Database Configuration
DB_PASSWORD=TimeTracker2024!
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=5083
BACKEND_HOST=localhost
ASPNETCORE_ENVIRONMENT=Production

# JWT Configuration
JWT_KEY=tu-clave-secreta-muy-larga-de-al-menos-256-bits-para-jwt-token-seguro
JWT_ISSUER=TimeTrackerApi
JWT_AUDIENCE=TimeTrackerApp

# Frontend Configuration
FRONTEND_PORT=4200

# API URL para el Frontend (se usa en build-time)
# Ejemplos:
#   - Para acceso desde navegador a backend local: http://localhost:5083/api
#   - Para acceso desde navegador a backend remoto: http://192.168.1.10:5083/api
#   - Para comunicación interna Docker: http://backend:80/api (no recomendado - el navegador no puede resolver 'backend')
API_URL=http://localhost:5083/api

# Timezone
TIMEZONE=America/Argentina/Buenos_Aires

# Seed Database (true/false)
SEED_DATABASE=false
