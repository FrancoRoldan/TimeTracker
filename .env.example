# Configuración de TimeTracker.
#
# TODOS los valores de este archivo tienen un valor por defecto equivalente en
# docker-compose.yml, así que la aplicación y la plataforma de observabilidad
# levantan sin crear un .env:
#
#   docker compose up -d                            solo la aplicación
#   docker compose --profile observability up -d    aplicación + Grafana
#
# Copiá este archivo a .env solo cuando necesites cambiar algo:
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DB_PASSWORD=TimeTracker2024!
DB_PORT=5432

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_PORT=5083
BACKEND_HOST=localhost
ASPNETCORE_ENVIRONMENT=Production

# Sembrar datos de ejemplo en el primer arranque (true/false).
# Usuarios que crea el seeder:
#   john@acme.com        / Admin123!     (Admin de ACME Corporation)
#   alice@acme.com       / Dev123!
#   bob@techstart.com    / Manager123!
#   carol@techstart.com  / Dev123!
SEED_DATABASE=true

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# CAMBIAR EN PRODUCCIÓN: esta clave es de ejemplo y está versionada.
JWT_KEY=tu-clave-secreta-muy-larga-de-al-menos-256-bits-para-jwt-token-seguro
JWT_ISSUER=TimeTrackerApi
JWT_AUDIENCE=TimeTrackerApp

# Origen exacto desde el que se sirve el frontend (esquema + host + puerto).
# Con ASPNETCORE_ENVIRONMENT=Production la API NO arranca si queda vacío.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=4200

# URL del API tal como la ve el NAVEGADOR (se inyecta en build-time).
#   - Backend local:        http://localhost:5083/api
#   - Backend remoto:       http://192.168.1.10:5083/api
#   - http://backend:80/api NO sirve: el navegador no resuelve 'backend'.
API_URL=http://localhost:5083/api

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
# La plataforma (OTel Collector, Tempo, Loki, Promtail, Prometheus y Grafana)
# está en el perfil "observability" para no encarecer el arranque normal:
#
#   docker compose --profile observability up -d
#
# Grafana: http://localhost:3000 — trae los datasources y dos dashboards ya
# configurados, y el salto entre logs y trazas resuelto en ambas direcciones.
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Destino de trazas y métricas. Ya apunta al Collector del perfil, así que no
# hay que tocarlo. Dejarlo VACÍO desactiva la exportación (la instrumentación
# se sigue generando y la aplicación funciona igual).
#   - Collector fuera de Docker: http://host.docker.internal:4317
OTLP_ENDPOINT=http://otel-collector:4317

# grpc (puerto 4317) o http/protobuf (puerto 4318), según escuche tu collector.
OTLP_PROTOCOL=grpc

# Cada cuánto exporta métricas el SDK (ms). El valor por defecto de OpenTelemetry
# son 60000: con eso un pico de errores tarda más de un minuto en verse en Grafana.
OTEL_METRIC_EXPORT_INTERVAL=15000

# Identidad del despliegue: se expone en GET /info, viaja en cada traza y
# acompaña a los errores del navegador, para correlacionar una degradación con
# el deploy que la provocó. Se hornea en la imagen y además se puede corregir
# por entorno sin reconstruir.
BUILD_VERSION=1.0.0
BUILD_COMMIT_SHA=unknown
BUILD_NUMBER=unknown

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
TIMEZONE=America/Argentina/Buenos_Aires
