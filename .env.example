# Database Configuration
DB_PASSWORD=TimeTracker2024!
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=5083
BACKEND_HOST=localhost
ASPNETCORE_ENVIRONMENT=Production

# JWT Configuration
JWT_KEY=tu-clave-secreta-muy-larga-de-al-menos-256-bits-para-jwt-token-seguro
JWT_ISSUER=TimeTrackerApi
JWT_AUDIENCE=TimeTrackerApp

# Frontend Configuration
FRONTEND_PORT=4200

# CORS: origen exacto desde el que se sirve el frontend (esquema + host + puerto).
# En ASPNETCORE_ENVIRONMENT=Production la API NO arranca si queda vacío.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# API URL para el Frontend (se usa en build-time)
# Ejemplos:
#   - Para acceso desde navegador a backend local: http://localhost:5083/api
#   - Para acceso desde navegador a backend remoto: http://192.168.1.10:5083/api
#   - Para comunicación interna Docker: http://backend:80/api (no recomendado - el navegador no puede resolver 'backend')
API_URL=http://localhost:5083/api

# Observabilidad
#
# La plataforma (Collector, Tempo, Loki, Prometheus, Grafana) vive en el perfil
# "observability" del docker-compose:
#   docker compose up -d                          solo la aplicación
#   docker compose --profile observability up -d  aplicación + plataforma
#
# Grafana queda en http://localhost:3000
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Endpoint OTLP del OpenTelemetry Collector (trazas y métricas).
# Si queda vacío, la instrumentación se genera pero no se exporta y la app
# funciona igual. Ejemplos:
#   - Con el perfil observability:          http://otel-collector:4317
#   - Collector fuera de Docker:            http://host.docker.internal:4317
OTLP_ENDPOINT=http://otel-collector:4317
# grpc (puerto 4317) o http/protobuf (puerto 4318), según escuche tu collector.
OTLP_PROTOCOL=grpc

# Identidad del despliegue: se inyecta en el build y se expone en GET /info
# y como atributos de recurso de la telemetría, para correlacionar una
# degradación con el deploy que la provocó.
BUILD_VERSION=1.0.0
BUILD_COMMIT_SHA=unknown
BUILD_NUMBER=unknown

# Timezone
TIMEZONE=America/Argentina/Buenos_Aires

# Seed Database (true/false)
SEED_DATABASE=false
